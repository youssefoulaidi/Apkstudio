    <string name="err_network_title">لا يوجد اتصال بالإنترنت</string>
    <string name="err_network_detail">تعذّر الوصول إلى ‏api.github.com‏ من الهاتف.</string>
    <string name="err_network_hint">تحقق من الواي فاي أو بيانات الهاتف ثم أعد المحاولة.</string>
    <string name="err_timeout_title">انتهت مهلة الاتصال</string>
    <string name="err_timeout_hint">الاتصال بطيء أو GitHub مشغول. أعد المحاولة بعد قليل.</string>
    <string name="err_ssl_title">فشل الاتصال الآمن</string>
    <string name="err_ssl_hint">تحقق من إعدادات التاريخ والوقت أو جرّب شبكة أخرى ثم أعد المحاولة.</string>

    <string name="err_401_title">رفض GitHub الرمز</string>
    <string name="err_401_detail">خطأ ‏HTTP 401‏ — بيانات اعتماد غير صالحة.</string>
    <string name="err_401_hint">الرمز خاطئ أو منتهي الصلاحية أو تم إلغاؤه. أنشئ رمزاً جديداً واربط حسابك مجدداً.</string>
    <string name="err_403_rate_title">تم تجاوز حد طلبات GitHub</string>
    <string name="err_403_rate_hint">طلبات كثيرة في وقت قصير. انتظر بضع دقائق وأعد المحاولة. المشاريع الكبيرة تستهلك طلبات أكثر.</string>
    <string name="err_403_scope_title">الرمز تنقصه صلاحيات</string>
    <string name="err_403_scope_detail">خطأ ‏HTTP 403‏ — المورد غير متاح.</string>
    <string name="err_403_scope_hint">يحتاج الرمز إلى صلاحيتي “repo” و“workflow”. أنشئ رمزاً جديداً بهما واربط مجدداً.</string>
    <string name="err_403_title">رفض GitHub الوصول</string>
    <string name="err_403_hint">تحقق من أن حسابك يملك صلاحية الوصول لهذا المستودع وأن الرمز يتضمن “repo” و“workflow”.</string>
    <string name="err_404_title">غير موجود على GitHub</string>
    <string name="err_404_hint">لم يتم العثور على المستودع أو الفرع أو ملف البناء أو عملية البناء. ربما تمت إعادة تسميته أو حذفه.</string>
    <string name="err_422_actions_title">خدمة GitHub Actions معطّلة</string>
    <string name="err_422_actions_detail">تعذّر بدء البناء لأن Actions متوقفة في هذا المستودع.</string>
    <string name="err_422_actions_hint">على GitHub افتح المستودع ← الإعدادات ← ‏Actions‏ ← ‏General‏، واسمح بتشغيلها. ثم أعد البناء.</string>
    <string name="err_422_title">رفض GitHub الطلب</string>
    <string name="err_422_hint">راجع التفاصيل التقنية بالأسفل. قد يكون ملف البناء مفقوداً — جرّب رفع المشروع مجدداً.</string>
    <string name="err_409_title">تعارض في حالة المستودع</string>
    <string name="err_409_hint">تغيّرت حالة المستودع بشكل غير متوقع. أعد المحاولة، وإن استمرت المشكلة استخدم مستودعاً فارغاً جديداً.</string>
    <string name="err_http_title">فشل طلب GitHub</string>
    <string name="err_http_hint">أعد المحاولة. إن استمرت المشكلة راجع التفاصيل التقنية أو حاول لاحقاً.</string>

    <string name="err_zip_title">تعذّر قراءة ملف ZIP</string>
    <string name="err_zip_detail">الملف المحدد تالف أو ليس أرشيف ZIP صالحاً.</string>
    <string name="err_zip_hint">أعد تصدير المشروع بصيغة ZIP (بدون كلمة مرور) وحاول مجدداً.</string>
    <string name="err_not_android_title">ليس مشروع أندرويد</string>
    <string name="err_not_android_detail">لم يتم العثور على بنية ‏settings.gradle‏ / ‏build.gradle‏ داخل الأرشيف.</string>
    <string name="err_not_android_hint">تأكد أن ملف ZIP يحتوي على مجلد مشروع Android Studio الكامل (الذي فيه ‏settings.gradle‏ ومجلد ‏app‏).</string>
    <string name="err_no_app_module_title">لا يوجد موديول تطبيق</string>
    <string name="err_no_app_module_detail">المشروع لا يحتوي على موديول ‏com.android.application‏، لذلك لا يمكن إنتاج APK.</string>
    <string name="err_no_app_module_hint">تأكد أن المشروع يحتوي على موديول تطبيق (مثل مجلد “app” مع ملف ‏build.gradle‏).</string>
    <string name="err_no_artifacts_title">لم يتم إنتاج APK</string>
    <string name="err_no_artifacts_detail">انتهى البناء لكنه لم يرفع أي نتيجة.</string>
    <string name="err_no_artifacts_hint">غالباً فشلت خطوة بناء Gradle بصمت. راجع سجل البناء وأعد البناء.</string>
    <string name="err_expired_artifact_title">انتهت صلاحية التنزيل</string>
    <string name="err_expired_artifact_hint">انتهت صلاحية نتيجة هذا البناء على GitHub. أعد بناء المشروع للحصول على APK جديد.</string>
    <string name="err_download_title">فشل التنزيل</string>
    <string name="err_download_hint">تحقق من الاتصال ومساحة التخزين ثم أعد محاولة التنزيل.</string>
    <string name="err_no_apk_in_zip_title">لا يوجد APK داخل النتيجة</string>
    <string name="err_no_apk_in_zip_detail">الأرشيف المنزّل لا يحتوي على أي ملف ‏‎.apk‏.</string>
    <string name="err_no_apk_in_zip_hint">أعد بناء المشروع. إن استمرت المشكلة راجع سجل البناء بحثاً عن أخطاء التغليف.</string>
    <string name="err_push_title">فشل الرفع إلى GitHub</string>
    <string name="err_push_hint">تحقق من الاتصال وصلاحيات الرمز (‏repo‏ + ‏workflow‏) ثم أعد محاولة الرفع.</string>
    <string name="err_dispatch_title">تعذّر بدء البناء</string>
    <string name="err_dispatch_hint">تأكد أن GitHub Actions مفعّلة للمستودع وأن ملف البناء تم رفعه، ثم أعد المحاولة.</string>
    <string name="err_run_not_found_title">لم يبدأ البناء</string>
    <string name="err_run_not_found_detail">أرسل التطبيق أمر التشغيل لكن لم تظهر أي عملية بناء على GitHub.</string>
    <string name="err_run_not_found_hint">افتح المستودع على GitHub ← تبويب ‏Actions‏، وتأكد من وجود سير عمل “ApkStudio Build” وأن Actions مفعّلة.</string>
    <string name="err_unknown_title">خطأ غير متوقع</string>
    <string name="err_unknown_hint">أعد المحاولة. إن استمرت المشكلة جرّب مستودعاً فارغاً جديداً.</string>

